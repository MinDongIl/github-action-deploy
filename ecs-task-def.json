{
  "family": "next-shop-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::077672914621:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::077672914621:role/ecsAppTaskRole",
  "containerDefinitions": [
    {
      "name": "shop-api",
      "image": "dummy/will-be-overwritten:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/shop-test",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "environment": []
    }
  ]
}
